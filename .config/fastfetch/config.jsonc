{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/anime/\" -type f | shuf -n1)",
    "height": 18,
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "break",
    // {
    //   "type": "custom",
    //   "format": "\u001b[36m    OS Info"
    // },
    {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "  󰣇 Distro",
      // "format": "{name} {arch}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      // "format": "{sysname} {release} {arch}",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "  󰘳 Shell",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "green"
    },
    // {
    //   "type": "packages",
    //   "key": "  󰏗 Packages",
    //   "keyColor": "green"
    // },
    // {
    //   "type": "vulkan",
    //   "key": "  󰟽 Vulkan",
    //   "keyColor": "yellow"
    // },
    // {
    //   "type": "opengl",
    //   "key": "   opengl",
    //   "keyColor": "yellow"
    // },
    // {
    //   "type": "opencl",
    //   "key": "   opencl",
    //   "keyColor": "yellow"
    // },
    // {
    //   "type": "theme",
    //   "key": "   Theme",
    //   "keyColor": "green"
    // },
    // {
    //   "type": "monitor",
    //   // "key": "   Monitor",
    //   "key": "   Monitor",
    //   "keyColor": "yellow"
    // },
    {
      "type": "display",
      // "key": "   Display",
      "key": "   Display",
      "keyColor": "yellow"
    },
    {
      "type": "lm",
      "key": "  󰧨 Login",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "   Desktop",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "   Window",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },
    "break",
    // {
    //   "type": "title",
    //   "key": "  "
    // },
    {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{name} @ {freq-max}",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "  󰋵 GPU",
      // "format": "{vendor} {name} {frequency}",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "  󰀚 RAM",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "key": "  󰯍 Swap",
      // "format": "{total} {percentage}",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "  󰉉 Disk ",
      "keyColor": "red"
    },
    {
      "type": "host",
      "key": "   Machine",
      "format": "{name} {version}",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
